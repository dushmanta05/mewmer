DATABASE_URL=postgres://dushmanta:password@localhost:5432/mewmer?sslmode=disable
PORT=3030
STORAGE_DIR=./uploads
MAX_WORKERS=2
CORS_ORIGIN=http://localhost:3031
SESSION_TTL=168h
SECURE_COOKIE=false
COOKIE_DOMAIN=

# filesystem (local dev) or r2 (production)
STORAGE_TYPE=filesystem

# Cloudflare R2 credentials — only needed when STORAGE_TYPE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=mewmer-public-media
R2_PRIVATE_BUCKET=mewmer-private-media

# Public custom domain for the public bucket, e.g. https://media.mewmer.com
# Leave empty if you are not using a custom domain (public URLs will not be generated)
R2_PUBLIC_ENDPOINT=https://media.mewmer.com
