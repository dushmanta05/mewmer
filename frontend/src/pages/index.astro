---
import Layout from '../layouts/Layout.astro';

interface PackItem {
  id: string;
  title: string;
  publisher: string;
  stickersCount: number;
  preview: string;
  downloads: string;
  isAnimated: boolean;
  tag: string;
}

const fallbackPacks: PackItem[] = [
  {
    id: 'cats-chaotic',
    title: 'Chaotic Felines Vol. 1',
    publisher: 'Mewmer Originals',
    stickersCount: 12,
    preview: 'https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=400&auto=format&fit=crop&q=80',
    downloads: '14.2k',
    isAnimated: false,
    tag: 'Trending',
  },
  {
    id: 'doge-reactions',
    title: 'Good Boi Express',
    publisher: 'DogeLover',
    stickersCount: 8,
    preview: 'https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=400&auto=format&fit=crop&q=80',
    downloads: '9.8k',
    isAnimated: false,
    tag: 'Popular',
  },
  {
    id: 'office-dev-chaos',
    title: 'Junior Dev Survived',
    publisher: 'Mewmer Community',
    stickersCount: 15,
    preview: 'https://images.unsplash.com/photo-1573865526739-10659fec78a5?w=400&auto=format&fit=crop&q=80',
    downloads: '22.1k',
    isAnimated: true,
    tag: 'Animated',
  }
];

let featuredPacks: PackItem[] = fallbackPacks;
try {
  const res = await fetch('http://localhost:3030/api/v1/packs');
  if (res.ok) {
    const data = await res.json();
    if (data.packs && data.packs.length > 0) {
      featuredPacks = data.packs.map((p: any) => ({
        id: p.id,
        title: p.title,
        publisher: p.publisher,
        stickersCount: p.stickers ? p.stickers.length : 1,
        preview: p.trayImageUrl,
        downloads: `${p.downloadsCount || 1}k`,
        isAnimated: p.isAnimated,
        tag: p.isAnimated ? 'Animated' : 'Community',
      }));
    }
  }
} catch {}

const features = [
  {
    icon: '⚡',
    title: 'Zero Server Lag',
    desc: 'Render memes and cropped images 100% locally in your browser using HTML5 Canvas. Instant 60 FPS feedback with zero wait time.',
  },
  {
    icon: '🎬',
    title: 'Animated GIF Cropping',
    desc: 'Upload looping animated GIFs, preview crops in real time, and convert them smoothly with dedicated worker pool processing.',
  },
  {
    icon: '📐',
    title: 'Aspect Ratios & Custom Pixels',
    desc: 'Crop to 1:1, 4:3, 16:9, or 9:16 reels, or dial in custom pixel widths and heights with step buttons and aspect locking.',
  },
  {
    icon: '✍️',
    title: 'Multi-Layer Captions',
    desc: 'Add unlimited caption layers. Rotate 360° with direct vector handles, scale dynamically, and position anywhere on canvas.',
  },
  {
    icon: '🔤',
    title: 'Curated Typography',
    desc: 'Choose from classic bold Impact meme headlines, Bebas Neue poster font, modern Poppins, Inter, and expressive Caveat script.',
  },
  {
    icon: '💾',
    title: 'Lossless & Multi-Format Export',
    desc: 'Export high-resolution WebP, JPG, or transparent PNG with adjustable compression quality, or copy directly to clipboard.',
  },
];

const steps = [
  {
    step: '01',
    title: 'Upload Photo or Animated GIF',
    desc: 'Drop in any picture, viral meme, or looping GIF. Mewmer supports all image formats with no forced square squishing.',
    icon: '🖼️',
  },
  {
    step: '02',
    title: 'Crop, Resize & Add Captions',
    desc: 'Pick standard ratios like 1:1, 16:9, or custom pixel sizes. Add unlimited text layers with 360° rotation and stylish fonts.',
    icon: '✍️',
  },
  {
    step: '03',
    title: 'Export WebP, JPG or PNG',
    desc: 'Download crystal-clear high-res memes or copy straight to clipboard for instant social media and chat sharing.',
    icon: '🚀',
  },
];

const faqs = [
  {
    q: 'Can I crop and caption both static images and animated GIFs?',
    a: 'Yes. You can upload standard photos (JPG, PNG, WebP) or animated GIFs. Static memes generate 100% in your browser with zero latency. Animated GIFs feature a real-time looping preview and are processed cleanly through our background media worker pool.',
  },
  {
    q: 'Can I resize images to specific custom pixel dimensions?',
    a: 'Yes. In the Crop & Ratio tab, you can choose preset ratios like 1:1, 4:3, 16:9, and 9:16, or enter custom pixel Width and Height with stepper controls and optional aspect ratio locking.',
  },
  {
    q: 'Can I add multiple text captions and rotate them?',
    a: 'Yes. You can add unlimited caption layers. Each caption has direct on-canvas handles for rotation and proportional scaling, as well as font selection, text colors, stroke outlines, and size sliders.',
  },
  {
    q: 'What formats can I export my memes and stickers in?',
    a: 'You can export in WebP, JPG, or PNG formats with adjustable compression quality, or copy directly to your clipboard for instant pasting into chats and social apps.',
  },
  {
    q: 'Do I need an account or software installation to use Mewmer?',
    a: 'No account, sign-up, or software installation is required. Mewmer runs entirely in modern web browsers on mobile, tablet, and desktop devices.',
  },
];
---

<Layout
  title="Mewmer — Crop, Resize & Caption Any Image or GIF Online"
  description="The instant browser studio to crop, resize, and caption photos and animated GIFs into viral memes. Free forever with high-res WebP, JPG, and PNG exports."
>
  <section class="relative pt-16 pb-24 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-600/20 via-brand-900/5 to-transparent pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/25 text-brand-300 text-xs font-semibold mb-6 shadow-sm">
          <span>✨</span>
          <span>100% Client-Side • Free & Instant</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-extrabold text-white tracking-tight leading-[1.1]">
          Create, Crop & Caption <span class="bg-gradient-to-r from-brand-400 via-meme-cyan to-whatsapp bg-clip-text text-transparent">Any Image or GIF</span> Into a Meme
        </h1>

        <p class="mt-6 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          The ultra-fast web studio to crop, resize, and add multi-layer rotating captions to photos and animated GIFs. Export in high-res WebP, JPG, or PNG in seconds.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/studio"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 text-white font-bold text-base shadow-xl shadow-brand-500/30 transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2"
          >
            <span>🎨</span>
            <span>Open Meme & Caption Studio — It's Free</span>
          </a>
        </div>

        <div class="mt-12 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs text-dark-muted font-medium">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span>
            <span>Any aspect ratio (1:1, 4:3, 16:9, 9:16)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span>
            <span>Multi-layer rotating captions</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span>
            <span>Animated GIF & photo cropping</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span>
            <span>High-res WebP, JPG & PNG</span>
          </div>
        </div>
      </div>

      <div class="mt-16 max-w-4xl mx-auto">
        <div class="relative rounded-2xl p-2 bg-gradient-to-b from-brand-500/30 via-dark-border to-transparent shadow-2xl">
          <div class="bg-dark-card rounded-xl p-6 sm:p-8 border border-dark-border/80">
            <div class="flex flex-col md:flex-row items-center justify-between gap-8">
              <div class="flex-1 space-y-4">
                <span class="px-2.5 py-1 rounded-md bg-brand-500/20 text-brand-300 border border-brand-500/30 text-xs font-bold uppercase tracking-wider">
                  Live Studio Demo
                </span>
                <h3 class="text-2xl font-bold font-display text-white">
                  Instant Browser-Based Meme Studio
                </h3>
                <p class="text-sm text-slate-300 leading-relaxed">
                  Crop photos or animated GIFs to any dimension, rotate bold meme captions with live handles, fine-tune custom typography, and export lightweight lossless graphics ready for social media and chats.
                </p>
                <div class="pt-2">
                  <a
                    href="/studio"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-brand-400 hover:text-brand-300 transition-colors"
                  >
                    <span>Launch Studio to customize your own</span>
                    <span>→</span>
                  </a>
                </div>
              </div>

              <div class="w-full md:w-72 aspect-square rounded-2xl bg-dark-bg border border-dark-border p-3 flex flex-col items-center justify-center relative overflow-hidden shadow-inner">
                <img
                  src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=400&auto=format&fit=crop&q=80"
                  alt="Meme demo preview"
                  class="w-full h-full object-cover rounded-xl"
                />
                <div class="absolute inset-x-0 bottom-4 text-center px-2">
                  <span class="font-impact text-xl sm:text-2xl text-white uppercase drop-shadow-[0_2px_2px_rgba(0,0,0,0.9)] tracking-wide">
                    ME AT 3 AM
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 border-y border-dark-border bg-dark-card/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs font-mono font-bold text-brand-400 uppercase tracking-widest mb-2">Simplicity First</h2>
        <h3 class="text-3xl sm:text-4xl font-display font-extrabold text-white">How It Works in 3 Simple Steps</h3>
        <p class="text-sm text-slate-400 mt-2">Start creating and exporting custom memes in under 30 seconds</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {steps.map((s) => (
          <div class="bg-dark-bg border border-dark-border rounded-2xl p-8 relative group hover:border-brand-500/40 transition-colors">
            <span class="text-4xl mb-6 block">{s.icon}</span>
            <span class="text-xs font-mono font-bold text-brand-400 uppercase tracking-widest">{s.step}</span>
            <h4 class="text-xl font-bold text-white mt-2 mb-3">{s.title}</h4>
            <p class="text-sm text-slate-400 leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs font-mono font-bold text-brand-400 uppercase tracking-widest mb-2">Built For Creators</h2>
        <h3 class="text-3xl sm:text-4xl font-display font-extrabold text-white">Why Mewmer is Different</h3>
        <p class="text-sm text-slate-400 mt-2">Engineered for speed, privacy, and frictionless graphic creation</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((f) => (
          <div class="bg-dark-card border border-dark-border rounded-2xl p-7 hover:border-brand-500/30 hover:shadow-lg transition-all">
            <div class="w-12 h-12 rounded-xl bg-dark-bg border border-dark-border flex items-center justify-center text-2xl mb-5">
              {f.icon}
            </div>
            <h4 class="text-lg font-bold text-white mb-2">{f.title}</h4>
            <p class="text-sm text-slate-400 leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-dark-border bg-dark-card/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <h2 class="text-xs font-mono font-bold text-brand-400 uppercase tracking-widest mb-2">Community</h2>
          <h3 class="text-3xl font-display font-extrabold text-white">Trending Packs & Templates</h3>
          <p class="text-sm text-slate-400 mt-1">Discover popular templates ready to customize in the studio</p>
        </div>
        <a
          href="/studio"
          class="text-sm font-semibold text-brand-400 hover:text-brand-300 transition-colors inline-flex items-center gap-1.5"
        >
          <span>Open Full Studio</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredPacks.map((pack) => (
          <div class="group bg-dark-card border border-dark-border rounded-2xl p-6 hover:border-brand-500/40 hover:shadow-xl hover:shadow-brand-500/10 transition-all duration-300">
            <div class="aspect-square rounded-xl overflow-hidden bg-dark-bg border border-dark-border relative flex items-center justify-center p-4">
              <img
                src={pack.preview}
                alt={pack.title}
                class="w-full h-full object-cover rounded-lg group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class="absolute top-3 right-3 px-2 py-0.5 rounded bg-brand-600/90 text-white font-bold text-[10px] uppercase tracking-wider">
                {pack.tag}
              </span>
            </div>

            <div class="mt-5 flex items-center justify-between">
              <div>
                <h4 class="text-lg font-bold text-white group-hover:text-brand-300 transition-colors">
                  {pack.title}
                </h4>
                <p class="text-xs text-dark-muted mt-0.5">By {pack.publisher} • {pack.stickersCount} stickers</p>
              </div>
              <span class="text-xs font-mono text-slate-400 bg-dark-bg px-2.5 py-1 rounded border border-dark-border">
                {pack.downloads}
              </span>
            </div>

            <div class="mt-5 pt-5 border-t border-dark-border flex items-center gap-3">
              <a
                href={`/packs/${pack.id}`}
                class="flex-1 py-2.5 rounded-xl bg-brand-500/20 hover:bg-brand-500/30 text-brand-300 border border-brand-500/40 font-semibold text-xs flex items-center justify-center gap-2 transition-colors"
              >
                <span>📦</span>
                <span>View Pack</span>
              </a>
              <a
                href="/studio"
                class="py-2.5 px-3.5 rounded-xl bg-dark-bg hover:bg-dark-border text-slate-300 font-semibold text-xs flex items-center justify-center transition-colors"
                title="Open in Studio"
              >
                <span>✨</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-dark-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-xs font-mono font-bold text-brand-400 uppercase tracking-widest mb-2">Got Questions?</h2>
        <h3 class="text-3xl font-display font-extrabold text-white">Frequently Asked Questions</h3>
      </div>

      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group bg-dark-card border border-dark-border rounded-xl p-5 hover:border-brand-500/40 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer list-none text-base font-bold text-white select-none">
              <span>{faq.q}</span>
              <span class="text-brand-400 text-lg transition-transform duration-200 group-open:rotate-180">▾</span>
            </summary>
            <p class="text-sm text-slate-300 mt-3 leading-relaxed border-t border-dark-border/40 pt-3">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-dark-border bg-gradient-to-b from-transparent to-brand-900/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
        Ready to Create Your Memes?
      </h3>
      <p class="mt-4 text-base text-slate-300 max-w-xl mx-auto">
        Crop, resize, and caption photos or animated GIFs in seconds. Free forever in your browser.
      </p>
      <div class="mt-8 flex justify-center">
        <a
          href="/studio"
          class="px-8 py-4 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 text-white font-bold text-base shadow-xl shadow-brand-500/25 transition-all hover:scale-[1.02] active:scale-[0.98]"
        >
          Open Studio Now — It's Free
        </a>
      </div>
    </div>
  </section>
</Layout>
