---
import Layout from '../layouts/Layout.astro';
import {
  Sparkles,
  ArrowRight,
  Upload,
  Crop,
  Download,
  Zap,
  Film,
  Layers,
  Type,
  FileImage,
  ChevronDown
} from 'lucide-astro';

interface MemeTemplate {
  id: string;
  title: string;
  preview: string;
  category: string;
  ratio: string;
  tag: string;
}

const popularTemplates: MemeTemplate[] = [
  {
    id: 'landscape-cat',
    title: 'Staring Cat',
    preview: 'https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=600&auto=format&fit=crop&q=80',
    category: 'Reaction Meme',
    ratio: '4:3 Standard',
    tag: 'Classic',
  },
  {
    id: 'square-doge',
    title: 'Good Doge',
    preview: 'https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=600&auto=format&fit=crop&q=80',
    category: 'Wholesome Doge',
    ratio: '1:1 Square',
    tag: 'Trending',
  },
  {
    id: 'animated-cat',
    title: 'Typing Cat (GIF)',
    preview: 'https://media.giphy.com/media/JIX9t2j0ZTN9S/giphy.gif',
    category: 'Developer Humor',
    ratio: 'Looping GIF',
    tag: 'Animated',
  },
];

const features = [
  {
    icon: Zap,
    title: 'Zero Lag',
    desc: 'Render memes locally in your browser with zero latency and instant 60 FPS previews.',
  },
  {
    icon: Film,
    title: 'Animated GIF Cropping',
    desc: 'Crop looping GIFs with real-time playback and smooth backend worker transcoding.',
  },
  {
    icon: Crop,
    title: 'Flexible Aspect Ratios',
    desc: 'Crop to 1:1, 4:3, 16:9, or 9:16, or enter custom pixel widths and heights.',
  },
  {
    icon: Layers,
    title: 'Multi-Layer Captions',
    desc: 'Add unlimited text layers with 360° rotation handles, scaling, and custom styling.',
  },
  {
    icon: Type,
    title: 'Curated Typography',
    desc: 'Choose from bold Impact, Bebas Neue poster font, modern Poppins, Inter, and Caveat.',
  },
  {
    icon: FileImage,
    title: 'Multi-Format Export',
    desc: 'Export high-resolution WebP, JPG, or PNG with custom compression quality.',
  },
];

const steps = [
  {
    step: '01',
    title: 'Upload Photo or GIF',
    desc: 'Drop in any image or looping animated GIF without forced square squishing.',
    icon: Upload,
  },
  {
    step: '02',
    title: 'Crop & Add Captions',
    desc: 'Select standard ratios or custom pixels. Add text layers with 360° rotation.',
    icon: Crop,
  },
  {
    step: '03',
    title: 'Export High-Res',
    desc: 'Download crisp WebP, JPG, or PNG, or copy directly to your clipboard.',
    icon: Download,
  },
];

const faqs = [
  {
    q: 'Can I crop and caption both static images and animated GIFs?',
    a: 'Yes. Upload photos (JPG, PNG, WebP) or animated GIFs. Static memes generate instantly in browser; animated GIFs are processed cleanly via our worker pool.',
  },
  {
    q: 'Can I resize images to specific custom pixel dimensions?',
    a: 'Yes. Select preset ratios (1:1, 4:3, 16:9, 9:16) or enter custom Width and Height pixels with stepper controls and optional aspect ratio locking.',
  },
  {
    q: 'Can I add multiple text captions and rotate them?',
    a: 'Yes. Add unlimited caption layers with direct on-canvas handles for rotation and scaling, custom fonts, colors, and outline strokes.',
  },
  {
    q: 'What formats can I export my memes in?',
    a: 'Export in WebP, JPG, or PNG formats with adjustable quality, or copy directly to your clipboard for instant sharing.',
  },
  {
    q: 'Do I need an account to use Mewmer?',
    a: 'No account or installation required. Mewmer runs completely in your browser across mobile, tablet, and desktop.',
  },
];
---

<Layout
  title="Mewmer — Crop, Resize & Caption Any Image or GIF Online"
  description="The instant browser studio to crop, resize, and caption photos and animated GIFs into viral memes. Free forever with high-res WebP, JPG, and PNG exports."
>
  <section class="relative pt-16 pb-24 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-600/20 via-brand-900/5 to-transparent pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/25 text-brand-300 text-xs font-semibold mb-6 shadow-sm">
          <Sparkles class="w-3.5 h-3.5 text-brand-400" />
          <span>Free & Instant • No Sign-Up</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-extrabold text-white tracking-tight leading-[1.1]">
          Create, Crop & Caption <span class="bg-gradient-to-r from-brand-400 via-meme-cyan to-whatsapp bg-clip-text text-transparent">Any Image or GIF</span> Into a Meme
        </h1>

        <p class="mt-6 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Crop, resize, and caption photos or animated GIFs with rotatable text layers. Export crisp WebP, JPG, or PNG in seconds.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/studio"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 text-white font-bold text-base shadow-xl shadow-brand-500/30 transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2.5"
          >
            <Sparkles class="w-5 h-5 text-white" />
            <span>Open Studio - Free</span>
          </a>
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <span class="inline-flex items-center px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-dark-card/60 backdrop-blur-md border border-white/10 text-slate-300 shadow-sm shadow-black/20 hover:border-brand-500/40 hover:text-white transition-colors">
            Photo & Animated GIF Cropping
          </span>
          <span class="inline-flex items-center px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-dark-card/60 backdrop-blur-md border border-white/10 text-slate-300 shadow-sm shadow-black/20 hover:border-brand-500/40 hover:text-white transition-colors">
            Multi-Layer Rotatable Captions
          </span>
          <span class="inline-flex items-center px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-dark-card/60 backdrop-blur-md border border-white/10 text-slate-300 shadow-sm shadow-black/20 hover:border-brand-500/40 hover:text-white transition-colors">
            WebP, JPG & PNG Exports
          </span>
        </div>
      </div>

      <div class="mt-16 max-w-4xl mx-auto">
        <div class="relative rounded-2xl p-2 bg-gradient-to-b from-brand-500/30 via-dark-border to-transparent shadow-2xl">
          <div class="bg-dark-card rounded-xl p-6 sm:p-8 border border-dark-border/80">
            <div class="flex flex-col md:flex-row items-center justify-between gap-8">
              <div class="flex-1 space-y-4">
                <span class="px-2.5 py-1 rounded-md bg-brand-500/20 text-brand-300 border border-brand-500/30 text-xs font-bold uppercase tracking-wider">
                  Browser Studio
                </span>
                <h3 class="text-2xl font-bold font-display text-white">
                  Instant Meme Studio
                </h3>
                <p class="text-sm text-slate-300 leading-relaxed">
                  Crop photos or GIFs to any ratio, add rotating captions with custom fonts, and export lightweight lossless images instantly.
                </p>
                <div class="pt-2">
                  <a
                    href="/studio"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-brand-400 hover:text-brand-300 transition-colors"
                  >
                    <span>Customize Your Own</span>
                    <ArrowRight class="w-4 h-4" />
                  </a>
                </div>
              </div>

              <div class="w-full md:w-72 aspect-square rounded-2xl bg-dark-bg border border-dark-border p-3 flex flex-col items-center justify-center relative overflow-hidden shadow-inner">
                <img
                  src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=400&auto=format&fit=crop&q=80"
                  alt="Meme demo preview"
                  class="w-full h-full object-cover rounded-xl"
                />
                <div class="absolute inset-x-0 bottom-4 text-center px-2">
                  <span class="font-impact text-xl sm:text-2xl text-white uppercase drop-shadow-[0_2px_2px_rgba(0,0,0,0.9)] tracking-wide">
                    ME AT 3 AM
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 border-y border-dark-border bg-dark-card/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs font-mono font-bold text-brand-400 uppercase tracking-widest mb-2">Simplicity First</h2>
        <h3 class="text-3xl sm:text-4xl font-display font-extrabold text-white">How It Works in 3 Simple Steps</h3>
        <p class="text-sm text-slate-400 mt-2">Create and export custom memes in under 30 seconds</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {steps.map((s) => (
          <div class="bg-dark-bg border border-dark-border rounded-2xl p-8 relative group hover:border-brand-500/40 transition-colors">
            <div class="flex items-center justify-between mb-5">
              <span class="text-xs font-mono font-bold text-brand-400 uppercase tracking-widest">{s.step}</span>
              <div class="w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/25 flex items-center justify-center text-brand-400">
                <s.icon class="w-5 h-5" />
              </div>
            </div>
            <h4 class="text-xl font-bold text-white mb-2">{s.title}</h4>
            <p class="text-sm text-slate-400 leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs font-mono font-bold text-brand-400 uppercase tracking-widest mb-2">Built For Creators</h2>
        <h3 class="text-3xl sm:text-4xl font-display font-extrabold text-white">Why Mewmer is Different</h3>
        <p class="text-sm text-slate-400 mt-2">Engineered for speed, privacy, and frictionless graphic creation</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((f) => (
          <div class="bg-dark-card border border-dark-border rounded-2xl p-7 hover:border-brand-500/30 hover:shadow-lg transition-all">
            <div class="w-11 h-11 rounded-xl bg-brand-500/10 border border-brand-500/25 flex items-center justify-center text-brand-400 mb-5">
              <f.icon class="w-5 h-5" />
            </div>
            <h4 class="text-lg font-bold text-white mb-2">{f.title}</h4>
            <p class="text-sm text-slate-400 leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-dark-border bg-dark-card/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <h2 class="text-xs font-mono font-bold text-brand-400 uppercase tracking-widest mb-2">Templates</h2>
          <h3 class="text-3xl font-display font-extrabold text-white">Popular Meme Templates</h3>
          <p class="text-sm text-slate-400 mt-1">Jumpstart your memes with preloaded formats in the studio</p>
        </div>
        <a
          href="/studio"
          class="text-sm font-semibold text-brand-400 hover:text-brand-300 transition-colors inline-flex items-center gap-1.5"
        >
          <span>Open Blank Studio</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {popularTemplates.map((template) => (
          <div class="group bg-dark-card border border-dark-border rounded-2xl p-6 hover:border-brand-500/40 hover:shadow-xl hover:shadow-brand-500/10 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="aspect-square rounded-xl overflow-hidden bg-dark-bg border border-dark-border relative flex items-center justify-center p-2">
                <img
                  src={template.preview}
                  alt={template.title}
                  class="w-full h-full object-cover rounded-lg group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
                <span class="absolute top-3 right-3 px-2 py-0.5 rounded bg-brand-600/90 text-white font-bold text-[10px] uppercase tracking-wider">
                  {template.tag}
                </span>
              </div>

              <div class="mt-5 flex items-center justify-between">
                <div>
                  <h4 class="text-lg font-bold text-white group-hover:text-brand-300 transition-colors">
                    {template.title}
                  </h4>
                  <p class="text-xs text-dark-muted mt-0.5">{template.category}</p>
                </div>
                <span class="text-xs font-mono text-brand-300 bg-brand-500/15 border border-brand-500/30 px-2 py-0.5 rounded">
                  {template.ratio}
                </span>
              </div>
            </div>

            <div class="mt-5 pt-5 border-t border-dark-border">
              <a
                href="/studio"
                class="w-full py-2.5 rounded-xl bg-brand-500/20 hover:bg-brand-500/30 text-brand-300 border border-brand-500/40 font-semibold text-xs flex items-center justify-center gap-2 transition-colors"
              >
                <span>Customize in Studio</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-dark-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-xs font-mono font-bold text-brand-400 uppercase tracking-widest mb-2">Got Questions?</h2>
        <h3 class="text-3xl font-display font-extrabold text-white">Frequently Asked Questions</h3>
      </div>

      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group bg-dark-card border border-dark-border rounded-xl p-5 hover:border-brand-500/40 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer list-none text-base font-bold text-white select-none">
              <span>{faq.q}</span>
              <ChevronDown class="w-4 h-4 text-brand-400 transition-transform duration-200 group-open:rotate-180" />
            </summary>
            <p class="text-sm text-slate-300 mt-3 leading-relaxed border-t border-dark-border/40 pt-3">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-dark-border bg-gradient-to-b from-transparent to-brand-900/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
        Ready to Create Your Memes?
      </h3>
      <p class="mt-4 text-base text-slate-300 max-w-xl mx-auto">
        Crop, resize, and caption photos or animated GIFs in seconds. Free forever in your browser.
      </p>
      <div class="mt-8 flex justify-center">
        <a
          href="/studio"
          class="px-8 py-4 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 text-white font-bold text-base shadow-xl shadow-brand-500/25 transition-all hover:scale-[1.02] active:scale-[0.98] inline-flex items-center gap-2.5"
        >
          <Sparkles class="w-5 h-5 text-white" />
          <span>Open Studio - Free</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
